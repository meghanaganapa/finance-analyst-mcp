# Which SQL planner to use: offline | anthropic | openai
# offline   = governed semantic layer, no key, no cost (default)
FINANCE_LLM=offline

# Safety limits
FINANCE_MAX_ROWS=200
FINANCE_TIMEOUT_MS=3000
# FINANCE_DB_PATH=data/finance.db
# Write one JSON trace per question here (optional)
# FINANCE_TRACE_DIR=traces

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI-compatible: OpenAI, Azure OpenAI, or a free local model via Ollama ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama example: `ollama pull qwen2.5-coder`, then:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-coder
